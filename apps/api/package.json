{
  "name": "@koinonia/api",
  "version": "0.1.0",
  "description": "Koinonia API - Fastify backend",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "pnpm db:test:migrate && vitest",
    "test:watch": "vitest --watch",
    "db:test:migrate": "tsx src/scripts/test-migrate.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:manual": "tsx src/scripts/apply-manual-migration.ts",
    "db:backfill": "tsx src/scripts/backfill-default-org.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/scripts/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@koinonia/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.29.1",
    "fastify-plugin": "4.5.1",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
